{
  "expo": {
    "name": "ULT Orders",
    "slug": "ult-orders",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ultorders",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F9F9F8"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yourname.ultorders",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ULT Orders uses your location to show nearby restaurants and orders in your area.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "ULT Orders uses your location to show nearby restaurants and orders in your area.",
        "NSCameraUsageDescription": "ULT Orders needs camera access to let you photograph your meals for your ULT orders.",
        "NSPhotoLibraryUsageDescription": "ULT Orders needs photo library access to let you attach photos and videos to your ULT orders.",
        "NSPhotoLibraryAddUsageDescription": "ULT Orders saves photos you take within the app to your photo library.",
        "NSMicrophoneUsageDescription": "ULT Orders needs microphone access to record video of your meals.",
        "NSUserTrackingUsageDescription": "We use analytics to improve the app experience and show you relevant content.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "associatedDomains": ["applinks:ultorders.app"],
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F9F9F8"
      },
      "package": "com.yourname.ultorders",
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "ultorders.app",
              "pathPrefix": "/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "ULT Orders needs access to your photos to attach images to your orders.",
          "cameraPermission": "ULT Orders needs camera access to photograph your meals.",
          "microphonePermission": "ULT Orders needs microphone access to record video of your meals."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "ULT Orders uses your location to show nearby restaurants and orders.",
          "locationWhenInUsePermission": "ULT Orders uses your location to show nearby restaurants and orders."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#C8472B",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "your-sentry-org",
          "project": "ult-orders"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      },
      "sentryDsn": "YOUR_SENTRY_DSN",
      "posthogApiKey": "YOUR_POSTHOG_API_KEY",
      "privacyPolicyUrl": "https://ultorders.app/privacy",
      "termsUrl": "https://ultorders.app/terms"
    }
  }
}
