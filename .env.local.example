# ─── Supabase ─────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Google Places API ────────────────────────────────────────────────────────
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=your-google-places-api-key

# ─── Sentry ───────────────────────────────────────────────────────────────────
# Get from sentry.io → Settings → Projects → Client Keys
EXPO_PUBLIC_SENTRY_DSN=https://your-key@oXXXXX.ingest.sentry.io/XXXXXXX
EXPO_PUBLIC_SENTRY_ENABLED=false   # set to true for preview/production

# ─── PostHog ──────────────────────────────────────────────────────────────────
# Get from posthog.com → Project Settings → API Keys
EXPO_PUBLIC_POSTHOG_API_KEY=phc_your_posthog_api_key

# ─── App environment ──────────────────────────────────────────────────────────
# development | preview | production
APP_ENV=development
